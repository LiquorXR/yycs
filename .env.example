# ===== 前端（Vite） =====
# API 基础地址（示例：/api 或 https://api.example.com）
VITE_API_BASE_URL=/api

# ===== 后端（FastAPI） =====
# 注：monorepo 下 .env 可与前端 VITE_* 变量共存；后端忽略未声明字段（VITE_ 前缀键）
# 应用配置
APP_NAME=振凡命理
APP_ENV=dev
DEBUG=true

# 数据库连接串（默认 SQLite 文件位于项目根目录）
DATABASE_URL=sqlite:///./app.db

# CORS 允许来源（JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 生辰数据加密密钥（AES-256-GCM，base64 编码 32 字节）
# 生成方式：openssl rand -base64 32
# 未配置时：dev 环境自动生成临时密钥（重启失效，仅限本地调试）；prod 环境启动报错
BIRTH_DATA_KEY=

# 企微「联系我」活码二维码 URL（已解锁报告 wecom 字段）；未配置时返回 null
WECOM_QRCODE_URL=

# ===== 收钱吧微信小店·代客下单（open-api.shouqianba.com，未配置时支付功能优雅降级：订单可创建、pay 字段返回 null）=====
# appKey 为服务端密钥，严禁下发前端、严禁打印日志；由收钱吧侧开通下发，手动填入
WXS_APPID=
WXS_APPKEY=
# 商城资料（开通资料提供）
WXS_MALL_SN=
WXS_MALL_SIGNATURE=
# 卖家主体（开通资料提供，固定值）
WXS_MERCHANT_ID=
WXS_MERCHANT_USER_ID=
# WXS_SELLER_ROLE=super_admin
# 商城场景采集：无采集字段填 "[]"；带备注模板填 JSON 字符串
# WXS_SCENES=[]
# 支付结果推送地址（公网可访问 HTTPS，如 https://www.sxzfcm.top/api/pay/notify）
WXS_NOTIFY_URL=
# 退款结果推送地址（公网可访问 HTTPS，如 https://www.sxzfcm.top/api/pay/refund-notify；只记录可查，不改订单主状态）
WXS_REFUND_NOTIFY_URL=
# 支付完成同步回跳 URL（支持 {orderNo} 占位，如 https://www.sxzfcm.top/pay/{orderNo}）
WXS_RETURN_URL=
# 推送验签公钥（PEM 全文；为空时使用对接文档第六章产线公共公钥）
# WXS_PUSH_PUBLIC_KEY=
# 微信小店小程序直跳参数（开通资料固定值；配置后跳过运行时查询，缺失时回退实时查询）
# WXS_MINIAPP_APPID=wx36e68952a60af089
# WXS_MINIAPP_PAGE_PATH=/KQPUJDAZVXH7/y4otuwrldsgy/index

# ===== 对账/补偿定时任务 =====
# 总开关（dev 默认关闭；prod 开启）：每 5 分钟扫描创建超 30 分钟的 CREATED 订单调用收钱吧查单
RECONCILE_ENABLED=false
# 扫描周期（秒），默认 5 分钟
RECONCILE_INTERVAL_SECONDS=300
# 超时阈值（分钟）：创建超过该时长仍为 CREATED 的订单进入查单补偿
RECONCILE_STALE_MINUTES=30

# ===== 生产部署（Docker Compose，服务器上复制为 .env 后修改） =====
# APP_ENV=prod
# DEBUG=false
# DATABASE_URL=sqlite:////data/app.db
# BIRTH_DATA_KEY=<openssl rand -base64 32 生成，丢失后历史密文不可解，务必备份>
# CORS_ORIGINS=["https://你的域名"]
# RECONCILE_ENABLED=true
# WXS_APPID=<微信小店 appid>
# WXS_APPKEY=<服务端密钥，手动填入>
# WXS_MALL_SN=<商城号>
# WXS_MALL_SIGNATURE=<商城签名>
# WXS_MERCHANT_ID=<商户Id>
# WXS_MERCHANT_USER_ID=<商户userId>
# WXS_NOTIFY_URL=https://www.sxzfcm.top/api/pay/notify
# WXS_REFUND_NOTIFY_URL=https://www.sxzfcm.top/api/pay/refund-notify
# WXS_RETURN_URL=https://www.sxzfcm.top/pay/{orderNo}
