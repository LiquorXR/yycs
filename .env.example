# ===== 前端（Vite） =====
# API 基础地址（示例：/api 或 https://api.example.com）
VITE_API_BASE_URL=/api

# ===== 后端（FastAPI） =====
# 注：monorepo 下 .env 可与前端 VITE_* 变量共存；后端忽略未声明字段（VITE_ 前缀键）
# 应用配置
APP_NAME=振凡命理
APP_ENV=dev
DEBUG=true

# 数据库连接串（默认 SQLite 文件位于项目根目录）
DATABASE_URL=sqlite:///./app.db

# CORS 允许来源（JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 生辰数据加密密钥（AES-256-GCM，base64 编码 32 字节）
# 生成方式：openssl rand -base64 32
# 未配置时：dev 环境自动生成临时密钥（重启失效，仅限本地调试）；prod 环境启动报错
BIRTH_DATA_KEY=

# 企微「联系我」活码二维码 URL（已解锁报告 wecom 字段）；未配置时返回 null
WECOM_QRCODE_URL=

# ===== 微信支付 V3（商户资质办理中，未配置时支付功能优雅降级：订单可创建、pay 字段返回 null）=====
# 商户号（微信支付商户平台获取）
WXPAY_MCHID=
# 公众号/小程序 appid（H5/Native 统一下单必填）
WXPAY_APPID=
# APIv3 密钥（32 字节，商户平台「APIv3 密钥」设置，用于回调报文解密）
WXPAY_APIV3_KEY=
# 商户 API 私钥路径（apiclient_key.pem，仅服务端持有；勿提交仓库）
WXPAY_PRIVATE_KEY_PATH=
# 商户证书序列号（Authorization 头 serial_no）
WXPAY_CERT_SERIAL=
# 微信支付平台证书路径（验签回调；未配置时 /api/pay/notify 一律返回 FAIL）
WXPAY_PLATFORM_CERT_PATH=
# 支付结果回调 URL（公网可访问 HTTPS，如 https://你的域名/api/pay/notify）
WXPAY_NOTIFY_URL=
# 退款结果回调 URL（本期退款回调为占位，预留配置）
WXPAY_REFUND_NOTIFY_URL=
# 微信支付 API 基址（沙箱联调可改）
# WXPAY_API_BASE=https://api.mch.weixin.qq.com

# ===== 对账/补偿定时任务 =====
# 总开关（dev 默认关闭；prod 开启）：每 5 分钟扫描创建超 30 分钟的 CREATED 订单调用微信查单
RECONCILE_ENABLED=false
# 扫描周期（秒），默认 5 分钟
RECONCILE_INTERVAL_SECONDS=300
# 超时阈值（分钟）：创建超过该时长仍为 CREATED 的订单进入查单补偿
RECONCILE_STALE_MINUTES=30

# ===== 生产部署（Docker Compose，服务器上复制为 .env 后修改） =====
# APP_ENV=prod
# DEBUG=false
# DATABASE_URL=sqlite:////data/app.db
# BIRTH_DATA_KEY=<openssl rand -base64 32 生成，丢失后历史密文不可解，务必备份>
# CORS_ORIGINS=["https://你的域名"]
# RECONCILE_ENABLED=true
# WXPAY_MCHID=<商户号>
# WXPAY_APPID=<公众号/小程序 appid>
# WXPAY_APIV3_KEY=<32 字节 APIv3 密钥>
# WXPAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
# WXPAY_CERT_SERIAL=<商户证书序列号>
# WXPAY_PLATFORM_CERT_PATH=/app/certs/wechatpay_platform.pem
# WXPAY_NOTIFY_URL=https://你的域名/api/pay/notify
# WXPAY_REFUND_NOTIFY_URL=https://你的域名/api/refund/notify
