# ===== 前端（Vite） =====
# API 基础地址（示例：/api 或 https://api.example.com）
VITE_API_BASE_URL=/api

# ===== 后端（FastAPI） =====
# 注：monorepo 下 .env 可与前端 VITE_* 变量共存；后端忽略未声明字段（VITE_ 前缀键）
# 应用配置
APP_NAME=振凡命理
APP_ENV=dev
DEBUG=true

# 数据库连接串（默认 SQLite 文件位于项目根目录）
DATABASE_URL=sqlite:///./app.db

# CORS 允许来源（JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 生辰数据加密密钥（AES-256-GCM，base64 编码 32 字节）
# 生成方式：openssl rand -base64 32
# 未配置时：dev 环境自动生成临时密钥（重启失效，仅限本地调试）；prod 环境启动报错
BIRTH_DATA_KEY=

# 企微「联系我」活码二维码 URL（已解锁报告 wecom 字段）；未配置时返回 null
WECOM_QRCODE_URL=

# ===== 收钱吧聚合支付（微信+支付宝，未配置时支付功能优雅降级：订单可创建、pay 字段返回 null）=====
# 终端凭证由收钱吧侧激活后下发，日常下单/查单签名用；到期前手动轮换
SQB_TERMINAL_SN=
SQB_TERMINAL_KEY=
# 收钱吧 API 基址 / WAP 网关（默认国内正式环境，一般不改）
# SQB_API_BASE=https://vsi-api.shouqianba.com
# SQB_GATEWAY=https://qr.shouqianba.com/gateway
# 支付结果异步回调 URL（公网可访问 HTTPS，如 https://www.sxzfcm.top/api/pay/notify）
SQB_NOTIFY_URL=
# 退款结果异步回调 URL（公网可访问 HTTPS，如 https://www.sxzfcm.top/api/pay/refund-notify；只记录可查，不改订单主状态）
SQB_REFUND_NOTIFY_URL=
# 支付完成同步回跳 URL（支持 {orderNo} 占位，如 https://www.sxzfcm.top/pay/{orderNo}）
SQB_RETURN_URL=
# 收钱吧公钥路径（PEM SubjectPublicKeyInfo；验签回调，未配置时 /api/pay/notify 一律返回 fail）
SQB_PUBLIC_KEY_PATH=
# 门店操作员（WAP/precreate 必填，无默认）
SQB_OPERATOR=

# ===== 对账/补偿定时任务 =====
# 总开关（dev 默认关闭；prod 开启）：每 5 分钟扫描创建超 30 分钟的 CREATED 订单调用收钱吧查单
RECONCILE_ENABLED=false
# 扫描周期（秒），默认 5 分钟
RECONCILE_INTERVAL_SECONDS=300
# 超时阈值（分钟）：创建超过该时长仍为 CREATED 的订单进入查单补偿
RECONCILE_STALE_MINUTES=30

# ===== 生产部署（Docker Compose，服务器上复制为 .env 后修改） =====
# APP_ENV=prod
# DEBUG=false
# DATABASE_URL=sqlite:////data/app.db
# BIRTH_DATA_KEY=<openssl rand -base64 32 生成，丢失后历史密文不可解，务必备份>
# CORS_ORIGINS=["https://你的域名"]
# RECONCILE_ENABLED=true
# SQB_TERMINAL_SN=<收钱吧终端号>
# SQB_TERMINAL_KEY=<收钱吧终端密钥>
# SQB_NOTIFY_URL=https://www.sxzfcm.top/api/pay/notify
# SQB_REFUND_NOTIFY_URL=https://www.sxzfcm.top/api/pay/refund-notify
# SQB_RETURN_URL=https://www.sxzfcm.top/pay/{orderNo}
# SQB_PUBLIC_KEY_PATH=/app/certs/shouqianba_pub.pem
