# 生产部署环境变量模板：cp .env.production.example .env 后仅需修改下方两处
APP_ENV=prod
DEBUG=false

# SQLite 数据卷绝对路径（容器内 /data，勿改回相对路径）
DATABASE_URL=sqlite:////data/app.db

# 生辰数据加密密钥：openssl rand -base64 32 生成
# 丢失后历史密文不可解密，务必备份
BIRTH_DATA_KEY=REPLACE_WITH_BASE64_32BYTES

# CORS 允许来源（JSON 数组）：同源反代下不触发，填生产域名
CORS_ORIGINS=["https://YOUR_DOMAIN"]

# 企微「联系我」活码二维码 URL：未配置时已解锁报告 wecom 字段返回 null
WECOM_QRCODE_URL=

# ===== 收钱吧聚合支付（商户资质未到位时留空即可，订单可创建、pay 字段返回 null）=====
# 公钥文件放置于服务器 certs/ 目录（docker-compose 已挂载到 /app/certs，只读）
SQB_TERMINAL_SN=
SQB_TERMINAL_KEY=
SQB_NOTIFY_URL=https://YOUR_DOMAIN/api/pay/notify
SQB_REFUND_NOTIFY_URL=https://YOUR_DOMAIN/api/pay/refund-notify
SQB_RETURN_URL=https://YOUR_DOMAIN/pay/{orderNo}
SQB_PUBLIC_KEY_PATH=/app/certs/shouqianba_pub.pem
# 门店操作员必填，无默认（如 zhenfan）；公钥为 PEM SubjectPublicKeyInfo，certs/ 仅 root 可读
SQB_OPERATOR=
# SQB_API_BASE=https://vsi-api.shouqianba.com
# SQB_GATEWAY=https://qr.shouqianba.com/gateway

# ===== 对账/补偿定时任务（prod 建议开启）=====
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_STALE_MINUTES=30
