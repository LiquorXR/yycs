# 生产部署环境变量模板：cp .env.production.example .env 后仅需修改下方两处
APP_ENV=prod
DEBUG=false

# SQLite 数据卷绝对路径（容器内 /data，勿改回相对路径）
DATABASE_URL=sqlite:////data/app.db

# 生辰数据加密密钥：openssl rand -base64 32 生成
# 丢失后历史密文不可解密，务必备份
BIRTH_DATA_KEY=REPLACE_WITH_BASE64_32BYTES

# CORS 允许来源（JSON 数组）：同源反代下不触发，填生产域名
CORS_ORIGINS=["https://YOUR_DOMAIN"]

# 企微「联系我」活码二维码 URL：未配置时已解锁报告 wecom 字段返回 null
WECOM_QRCODE_URL=

# ===== 限时0元促销（免付加企微；关闭或过期自动恢复原价）=====
# 活动期间设为 true，并按需填写截止时间；结束后改回 false 即恢复原价
FREE_PROMO_ENABLED=false
FREE_PROMO_PRODUCT_IDS=[1]
# 截止时间 UTC ISO8601，为空则不限时，如 2026-10-01T00:00:00Z
FREE_PROMO_END_AT=

# ===== 收钱吧微信小店·代客下单（资质未到位时留空即可，订单可创建、pay 字段返回 null）=====
# appKey 为服务端密钥，手动填入，严禁进前端/日志
WXS_APPID=
WXS_APPKEY=
WXS_MALL_SN=
WXS_MALL_SIGNATURE=
WXS_MERCHANT_ID=
WXS_MERCHANT_USER_ID=
# WXS_SELLER_ROLE=super_admin
# WXS_SCENES=[]
WXS_NOTIFY_URL=https://YOUR_DOMAIN/api/pay/notify
WXS_REFUND_NOTIFY_URL=https://YOUR_DOMAIN/api/pay/refund-notify
WXS_RETURN_URL=https://YOUR_DOMAIN/pay/{orderNo}
# 推送验签公钥（PEM 全文；为空时使用对接文档第六章产线公共公钥）
# WXS_PUSH_PUBLIC_KEY=
# 微信小店小程序直跳参数（开通资料固定值；配置后跳过运行时查询）
# WXS_MINIAPP_APPID=wx36e68952a60af089
# WXS_MINIAPP_PAGE_PATH=/KQPUJDAZVXH7/y4otuwrldsgy/index

# ===== 对账/补偿定时任务（prod 建议开启）=====
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_STALE_MINUTES=30
